{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engineering-compass.evidence-bundle.v2",
  "type": "object",
  "required": [
    "schema_version",
    "target",
    "review_intent",
    "review_intent_digest",
    "identity",
    "freshness",
    "completeness",
    "evidence_records",
    "evidence_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "repository",
            "pr_number"
          ],
          "properties": {
            "kind": {
              "const": "PR_SCOPE"
            },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "pr_number": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "repository",
            "base_ref",
            "target_ref"
          ],
          "properties": {
            "kind": {
              "const": "REF_DELTA_SCOPE"
            },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "base_ref": {
              "type": "string",
              "minLength": 1
            },
            "target_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "repository",
            "ref"
          ],
          "properties": {
            "kind": {
              "const": "REPOSITORY_SCOPE"
            },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "review_intent": {
      "type": "string",
      "minLength": 1
    },
    "review_intent_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object"
    },
    "freshness": {
      "enum": [
        "CURRENT",
        "STALE",
        "UNKNOWN"
      ]
    },
    "completeness": {
      "type": "object",
      "required": [
        "full_coverage",
        "material_gaps",
        "surfaces"
      ],
      "properties": {
        "full_coverage": {
          "type": "boolean"
        },
        "material_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "surfaces": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "properties": {
            "changed_file_inventory": {
              "type": "boolean"
            },
            "diff_content": {
              "type": "boolean"
            },
            "reviews": {
              "type": "boolean"
            },
            "conversation_comments": {
              "type": "boolean"
            },
            "inline_review_comments": {
              "type": "boolean"
            },
            "checks": {
              "type": "boolean"
            },
            "commit_statuses": {
              "type": "boolean"
            },
            "review_threads": {
              "type": "boolean"
            },
            "repository_tree_inventory": {
              "type": "boolean"
            },
            "repository_source_content": {
              "type": "boolean"
            },
            "target_stabilization": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "evidence_records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "kind": {
                "const": "PR_SCOPE"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "completeness": {
            "properties": {
              "surfaces": {
                "required": [
                  "target_stabilization",
                  "changed_file_inventory",
                  "diff_content",
                  "reviews",
                  "conversation_comments",
                  "inline_review_comments",
                  "checks",
                  "commit_statuses",
                  "review_threads"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "kind": {
                "const": "REF_DELTA_SCOPE"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "completeness": {
            "properties": {
              "surfaces": {
                "required": [
                  "target_stabilization",
                  "changed_file_inventory",
                  "diff_content"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "kind": {
                "const": "REPOSITORY_SCOPE"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "completeness": {
            "properties": {
              "surfaces": {
                "required": [
                  "target_stabilization",
                  "repository_tree_inventory",
                  "repository_source_content"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
